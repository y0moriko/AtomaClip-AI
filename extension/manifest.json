{
  "manifest_version": 3,
  "name": "AtomaClip AI",
  "version": "1.1",
  "description": "Capture atomic insights with AI-powered semantic search. Now with PDF support!",
  "permissions": ["contextMenus", "activeTab", "storage", "cookies"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js", "pdf_handler.js"],
      "css": ["content_styles.css"]
    }
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "AtomaClip AI"
  },
  "options_page": "settings.html"
}
